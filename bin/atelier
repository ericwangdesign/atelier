#!/bin/sh
# atelier: open Atelier from any terminal. If it's already running (started by a Claude session, another terminal),
# it just opens it; if not, it starts it in the background and opens it once it answers.
#   atelier            home
#   atelier stride     a project's stage
#   atelier stop       stop the one running
#   atelier log        what it said lately
#   atelier taste      the taste list; atelier taste add "rule" --why "what Eric said"
# Linked into /opt/homebrew/bin. ATELIER_PORT moves it off 4321.
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
DIR=$(cd "$(dirname "$self")/.." && pwd)
PORT=${ATELIER_PORT:-4321}
LOG="$HOME/Library/Logs/atelier.log"
up() { curl -sf -m 1 -o /dev/null "http://localhost:$PORT/api/projects"; }
pid() { lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null | head -1; }

case "$1" in
  stop)
    p=$(pid)
    if [ -n "$p" ] && up; then kill "$p" && echo "Stopped Atelier on $PORT."; else echo "Atelier isn't running on $PORT."; fi
    exit 0 ;;
  log) tail -n 40 "$LOG"; exit 0 ;;
  taste) shift; exec python3 "$DIR/taste.py" "$@" ;;
  -h|--help|help) sed -n '2,9p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

url="http://localhost:$PORT/"
[ -n "$1" ] && url="http://localhost:$PORT/stage.html?project=$1"

if up; then
  echo "Atelier is already running. Opening $url"
elif [ -n "$(pid)" ]; then
  echo "Something else is on port $PORT, not Atelier. Run it on another: ATELIER_PORT=4322 atelier"
  exit 1
else
  echo "Starting Atelier on $PORT (log: atelier log)"
  cd "$DIR" && nohup python3 serve.py "$PORT" >>"$LOG" 2>&1 &
  i=0
  until up; do
    i=$((i + 1))
    if [ $i -gt 40 ]; then echo "It didn't start. Last lines of the log:"; tail -n 15 "$LOG"; exit 1; fi
    sleep 0.25
  done
fi
[ -z "$ATELIER_NO_OPEN" ] && open "$url"
exit 0
